# Board: 16 MB quad flash, 8 MB octal PSRAM (from Waveshare's LVGL example).
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Code and the embedded art stay in flash: copied into PSRAM they'd take
# nearly all of it, leaving LVGL under a megabyte to draw with.
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# The console on the native USB, so the board can be driven and screenshotted
# from the Mac (scripts/device/snap.py).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# LVGL
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_USE_SNAPSHOT=y
CONFIG_LV_USE_ARCLABEL=y
# Sub-degree angles, so letters set on an arc keep even spacing.
CONFIG_LV_USE_FLOAT=y
# Keep the last blurred shadow, so a slip fading in doesn't re-blur every frame.
CONFIG_LV_DRAW_SW_SHADOW_CACHE_SIZE=32
# Lines may break after these, but not after a full stop: "2.2 miles" stays whole.
CONFIG_LV_TXT_BREAK_CHARS=" ,;:-_)}"
CONFIG_LV_CACHE_DEF_SIZE=2097152
CONFIG_LV_IMAGE_HEADER_CACHE_DEF_CNT=32
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_USE_PERF_MONITOR=n
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
